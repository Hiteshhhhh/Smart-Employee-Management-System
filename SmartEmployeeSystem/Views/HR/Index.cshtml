@{
    ViewData["Title"] = "Employees";
}

<div class="d-flex justify-content-between align-items-center">
    <h2>Employees</h2>
    <a asp-action="AddEmployee" class="btn btn-primary">+ Add Employee</a>
</div>
<hr />

<div id="employeeGrid"></div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $("#employeeGrid").kendoGrid({
                dataSource: {
                    transport: {
                        read: {
                            url: "/api/SmartEmployee",
                            type: "GET",
                            dataType: "json"
                        },
                        update: {
                            url: function(data) {
                                return "/api/SmartEmployee/" + data.employee_id;
                            },
                            type: "PUT",
                            contentType: "application/json",
                            dataType: "json"
                        },
                        destroy: {
                            url: function(data) {
                                return "/api/SmartEmployee/" + data.employee_id;
                            },
                            type: "DELETE"
                        },
                        parameterMap: function(data, operation) {
                            if (operation === "update") {
                                return JSON.stringify(data);
                            }
                            return data;
                        }
                    },
                    schema: {
                        model: {
                            id: "employee_id",
                            fields: {
                                employee_id:     { type: "number", editable: false },
                                first_name:      { type: "string" },
                                last_name:       { type: "string" },
                                employee_code:   { type: "string" },
                                department_name: { type: "string" },
                                designation:     { type: "string" },
                                base_salary:     { type: "number" },
                                date_of_joining: { type: "date" }
                            }
                        }
                    },
                    pageSize: 10
                },
                height: 500,
                pageable: true,
                sortable: true,
                filterable: true,
                columns: [
                    { field: "employee_id",     title: "ID",           width: 60 },
                    { field: "first_name",      title: "First Name" },
                    { field: "last_name",       title: "Last Name" },
                    { field: "employee_code",   title: "Emp Code" },
                    { field: "department_name", title: "Department" },
                    { field: "designation",     title: "Designation" },
                    { field: "base_salary",     title: "Salary" },
                    { field: "date_of_joining", title: "Joining Date", format: "{0:dd-MM-yyyy}" },
                    { command: ["edit", "destroy"], title: "Actions", width: 180 }
                ],
                editable: "inline"
            });
        });
    </script>
}