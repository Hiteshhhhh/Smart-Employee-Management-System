@model SmartEmployeeSystem.Models.EmployeeModel

@{
    ViewData["Title"] = "Add Employee";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <h2>Add Employee</h2>
            <hr />

            <form asp-action="AddEmployee" method="post">
                <div class="mb-3">
                    <label>First Name</label>
                    <input id="first_name" asp-for="first_name"  />
                </div>
                <div class="mb-3">
                    <label>Last Name</label>
                    <input id="last_name" asp-for="last_name" />
                </div>
                <div class="mb-3">
                    <label>Employee Code</label>
                    <input id="employee_code" asp-for="employee_code" />
                </div>
                <div class="mb-3">
                    <label>Department</label>
                    <select id="department_id" asp-for="department_id">
                        <option value="">-- Select Department --</option>
                        @foreach (var dept in ViewBag.Departments)
                        {
                            <option value="@dept.department_id">
                                @dept.department_name
                            </option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label>Username</label>
                    <input id="username" asp-for="username" />
                </div>
                <div class="mb-3">
                    <label>Email</label>
                    <input id="email" asp-for="email"  type="email" />
                </div>
                <div class="mb-3">
                    <label>Designation</label>
                    <input id="designation" asp-for="designation"  />
                </div>
                <div class="mb-3">
                    <label>Base Salary</label>
                    <input id="base_salary" asp-for="base_salary"  type="number" />
                </div>
                <div class="mb-3">
                    <label>Date of Joining</label>
                    <input id="date_of_joining" asp-for="date_of_joining"/>
                </div>
                <button type="submit" class="btn btn-primary">Add Employee</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>

@section Scripts{
    <script>
        $(document).ready(function(){
             $("#first_name").kendoTextBox();
            $("#last_name").kendoTextBox();
            $("#employee_code").kendoTextBox();
            $("#username").kendoTextBox();
            $("#email").kendoTextBox();
            $("#designation").kendoTextBox();
            $("#base_salary").kendoNumericTextBox();
            $("#date_of_joining").kendoDatePicker();
            $("#department_id").kendoDropDownList();
        })
    </script>
}